# Dev database (docker-compose service `db`, published on 55432 to avoid
# colliding with a locally-installed PostgreSQL on 5432).
GLASSBOX_DSN=postgresql://glassbox:glassbox@localhost:55432/glassbox

# Tests drop and recreate this database at session start. It must NOT be the
# dev database — conftest.py refuses to run if the two are equal.
GLASSBOX_TEST_DSN=postgresql://glassbox:glassbox@localhost:55432/glassbox_test

# The generator's reference "today". Everything downstream is deterministic
# against this instant; changing it invalidates fixtures/expected_scores.json.
GLASSBOX_NOW=2026-01-15T15:00:00+00:00
