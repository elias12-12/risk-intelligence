        "actions": {
          "items": {
            "$ref": "#/$defs/ActionValue"
          },
          "title": "Actions",
          "type": "array"
        },
        "aggregations": {
          "items": {
            "type": "string"
          },
          "title": "Aggregations",
          "type": "array"
        },
        "combine_values": {
          "items": {
            "type": "string"
          },
          "title": "Combine Values",
          "type": "array"
        },
        "execution_modes": {
          "items": {
            "$ref": "#/$defs/NamedValue"
          },
          "title": "Execution Modes",
          "type": "array"
        },
        "operators": {
          "items": {
            "$ref": "#/$defs/OperatorValue"
          },
          "title": "Operators",
          "type": "array"
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/NamedValue"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "rule_statuses": {
