{
  "$defs": {
    "FeatureView": {
      "additionalProperties": false,
      "description": "One catalog row, spec and all.\n\n`default_when_absent` is published as-is, including the difference between\nSQL NULL and JSON `null`: `has_default` is the field that carries it, because\n§5's whole distinction is between \"no default, let absence stay observable\"\nand \"0 is the real answer\" and JSON cannot express that difference alone.",
      "properties": {
        "aggregation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregation"
        },
        "baseline_spec": {
          "default": null,
          "title": "Baseline Spec"
        },
        "default_reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Reason Code"
        },
        "default_when_absent": {
          "default": null,
          "title": "Default When Absent"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "entity_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
