        },
        "feature_key": {
          "title": "Feature Key",
          "type": "string"
        },
        "filter_predicate": {
          "default": null,
          "title": "Filter Predicate"
        },
        "has_default": {
          "default": false,
          "title": "Has Default",
          "type": "boolean"
        },
        "inline_capable": {
          "title": "Inline Capable",
          "type": "boolean"
        },
        "is_graph": {
          "default": false,
