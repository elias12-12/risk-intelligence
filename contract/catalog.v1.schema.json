          },
          "title": "Subject Types",
          "type": "array"
        }
      },
      "title": "ReferenceVocabulary",
      "type": "object"
    },
    "RuleDetail": {
      "$defs": {
        "ConditionPerformance": {
          "additionalProperties": false,
          "description": "What a condition actually did, as opposed to what it was priced at.",
          "properties": {
            "alert_precision_pct": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Alert Precision Pct"
            },
            "basis": {
              "default": "v_condition_performance over decision_conditions: every condition of every applicable rule, fired or not. precision_pct is direction-aware — the fraud rate for an aggravator, the legitimate rate for a mitigator — measured against transactions.synthetic_label, which is exact on this dataset and meaningless outside it. points_per_precision_point is what the catalog charges per unit of measured precision, and HIGH IS BAD.",
              "title": "Basis",
              "type": "string"
            },
            "degraded": {
              "title": "Degraded",
              "type": "integer"
            },
            "evaluated": {
              "title": "Evaluated",
              "type": "integer"
            },
            "fire_rate_pct": {
              "anyOf": [
                {
                  "type": "number"
