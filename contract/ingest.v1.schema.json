{
  "$defs": {
    "AuthorizationOutcome": {
      "$defs": {
        "Action": {
          "additionalProperties": false,
          "properties": {
            "clear_text": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Clear Text"
            },
            "prevent_threshold_met": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Prevent Threshold Met"
            },
            "recommended_text": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Recommended Text"
            },
            "source_rule": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Source Rule"
            },
            "taken": {
              "title": "Taken",
              "type": "string"
            },
            "vetoed_by": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Vetoed By"
            }
          },
          "required": [
            "taken"
          ],
          "title": "Action",
          "type": "object"
        },
        "Evidence": {
          "additionalProperties": false,
          "description": "What the decision could see, and what it could not.",
          "properties": {
            "degraded_features": {
              "items": {
                "type": "string"
              },
              "title": "Degraded Features",
              "type": "array"
            },
            "evaluation_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Evaluation Id"
            },
            "evaluation_trigger": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Evaluation Trigger"
            },
            "feature_version_set": {
              "additionalProperties": {
                "type": "integer"
              },
              "title": "Feature Version Set",
              "type": "object"
            },
            "pit_bound_at": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Pit Bound At"
            },
            "replay_as_of": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Replay As Of"
            },
            "rule_version_set": {
              "additionalProperties": {
                "type": "integer"
              },
              "title": "Rule Version Set",
              "type": "object"
            },
            "trigger_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Trigger Id"
            },
            "trigger_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Trigger Type"
            }
          },
          "title": "Evidence",
          "type": "object"
        },
        "ExecutionIssued": {
          "additionalProperties": false,
          "description": "One thing the decision actually caused. Empty when the action was\n`allow`: nothing is issued for a charge nobody objected to.",
          "properties": {
            "action": {
              "title": "Action",
              "type": "string"
            },
            "channel": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Channel"
            },
            "execution_id": {
              "title": "Execution Id",
              "type": "integer"
            },
            "issued_at": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Issued At"
            }
          },
          "required": [
            "execution_id",
            "action"
          ],
          "title": "ExecutionIssued",
          "type": "object"
        },
        "Signal": {
          "additionalProperties": false,
          "properties": {
            "asserted_by_rules": {
              "items": {
                "type": "string"
              },
              "title": "Asserted By Rules",
              "type": "array"
            },
            "contribution": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                }
              ],
              "title": "Contribution"
            },
            "direction": {
              "enum": [
                "aggravating",
                "mitigating",
                "veto"
              ],
              "title": "Direction",
              "type": "string"
            },
            "feature_key": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Feature Key"
            },
            "feature_value": {
              "default": null,
              "title": "Feature Value"
            },
            "human_text": {
              "title": "Human Text",
              "type": "string"
            },
            "rank": {
              "title": "Rank",
              "type": "integer"
            },
            "reason_code": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Reason Code"
            },
            "source_rule_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Source Rule Id"
            },
            "value_as_of": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Value As Of"
            },
            "value_computed_at": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Value Computed At"
            }
          },
          "required": [
            "rank",
            "feature_key",
            "contribution",
            "direction",
            "human_text"
          ],
          "title": "Signal",
          "type": "object"
        },
        "Subject": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "title": "Id",
              "type": "string"
            },
            "role": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Role"
            },
            "type": {
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "title": "Subject",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "What the engine did with a charge that asked to be approved.\n\n`persisted` is `True` and stated, the mirror of `simulation.v1`'s literal\n`false`. The two surfaces are deliberately shaped alike so a console can\nrender either — and deliberately not interchangeable, because the guarantee\neach carries is the opposite one.",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action"
        },
        "alert_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alert Id"
        },
        "alert_routing": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alert Routing"
        },
        "authorization": {
          "enum": [
            "approved",
            "declined"
          ],
          "title": "Authorization",
          "type": "string"
        },
        "band": {
          "title": "Band",
          "type": "string"
        },
        "basis": {
          "default": "The inline lane, run synchronously in this request: the charge was written, the features an arriving transaction drives were recomputed at its instant, the rules were evaluated, precedence chose an action, and the row was committed carrying the auth_result that action implies. Everything here is STORED — this is not a simulation.",
          "title": "Basis",
          "type": "string"
        },
        "decision_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Id"
        },
        "decline_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decline Reason"
        },
        "device_registered": {
          "default": false,
          "title": "Device Registered",
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "executions": {
          "items": {
            "$ref": "#/$defs/ExecutionIssued"
          },
          "title": "Executions",
          "type": "array"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "persisted": {
          "const": true,
          "default": true,
          "title": "Persisted",
          "type": "boolean"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Score"
        },
        "signals": {
          "items": {
            "$ref": "#/$defs/Signal"
          },
          "title": "Signals",
          "type": "array"
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "txn_id": {
          "title": "Txn Id",
          "type": "string"
        }
      },
      "required": [
        "txn_id",
        "subject",
        "occurred_at",
        "authorization",
        "score",
        "band",
        "action",
        "evidence"
      ],
      "title": "AuthorizationOutcome",
      "type": "object"
    },
    "CycleReport": {
      "additionalProperties": false,
      "description": "One turn of the background cycle, published so the console can show that\nsomething is actually running rather than implying it.",
      "properties": {
        "as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
        },
        "clusters": {
          "default": 0,
          "title": "Clusters",
          "type": "integer"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "feature_values": {
          "default": 0,
          "title": "Feature Values",
          "type": "integer"
        },
        "lanes": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object"
          },
          "title": "Lanes",
          "type": "object"
        },
        "ran": {
          "title": "Ran",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "since": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Since"
        }
      },
      "required": [
        "ran"
      ],
      "title": "CycleReport",
      "type": "object"
    },
    "IngestReceipt": {
      "$defs": {
        "Rejected": {
          "additionalProperties": false,
          "description": "One row that was not written, and why. Every reason, not the first.",
          "properties": {
            "index": {
              "title": "Index",
              "type": "integer"
            },
            "reasons": {
              "items": {
                "type": "string"
              },
              "title": "Reasons",
              "type": "array"
            }
          },
          "required": [
            "index"
          ],
          "title": "Rejected",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "What a batch actually did to the database.\n\n`duplicates` is separate from `rejected` on purpose: re-POSTing a batch\nafter a timeout is a retry, not an error, and a receipt that counted it as a\nfailure would push a caller toward doing something worse. Raw capture is\nappend-only, so the duplicate is DROPPED rather than merged — an arriving\nrow may not take the identity of one already recorded.",
      "properties": {
        "basis": {
          "default": "Rows reported as already settled. They are written to raw capture and evaluated by the next cycle, not by this request — so an alert appears when the scheduler next runs, or immediately if a lane is run by hand. Nothing here decided anything.",
          "title": "Basis",
          "type": "string"
        },
        "devices_registered": {
          "items": {
            "type": "string"
          },
          "title": "Devices Registered",
          "type": "array"
        },
        "duplicates": {
          "items": {
            "type": "string"
          },
          "title": "Duplicates",
          "type": "array"
        },
        "max_occurred_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Occurred At"
        },
        "rejected": {
          "items": {
            "$ref": "#/$defs/Rejected"
          },
          "title": "Rejected",
          "type": "array"
        },
        "relation": {
          "title": "Relation",
          "type": "string"
        },
        "submitted": {
          "title": "Submitted",
          "type": "integer"
        },
        "written": {
          "title": "Written",
          "type": "integer"
        }
      },
      "required": [
        "relation",
        "submitted",
        "written"
      ],
      "title": "IngestReceipt",
      "type": "object"
    }
  },
  "$id": "https://glassbox.local/contract/ingest.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Frozen. Generated by scripts/export_contract_schema.py from src/glassbox/contract/models.py. Do not edit by hand; a breaking change becomes ingest.v2.schema.json and v1 keeps being served.",
  "title": "GlassBox arrival contract, version 1"
}
